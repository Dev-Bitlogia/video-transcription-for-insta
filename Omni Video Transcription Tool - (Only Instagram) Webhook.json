        "jsCode": "// GitHub artifact downloads sometimes arrive without a fileExtension.\n// The Compression node throws if fileExtension is missing, so set it here.\nconst items = $input.all();\nfor (const item of items) {\n  if (item.binary && item.binary.data) {\n    item.binary.data.fileExtension = 'zip';\n    item.binary.data.fileName = 'reel-report.zip';\n  }\n}\nreturn items;"
